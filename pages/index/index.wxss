.search-box {
  padding: 20rpx;
}

.search-input {
  height: 72rpx;
  border-radius: 16rpx;
  padding: 0 22rpx;
  background: #f4f7fb;
}

.tour-card {
  margin-bottom: 24rpx;
}

.cover {
  width: 100%;
  height: 280rpx;
}

.content {
  padding: 20rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.meta {
  color: #6b7280;
  margin-bottom: 14rpx;
}

.footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.price {
  color: #ef4444;
  font-size: 32rpx;
  font-weight: 700;
}

.seats {
  color: #2563eb;
}

.empty {
  color: #6b7280;
  text-align: center;
  margin-top: 120rpx;
}
