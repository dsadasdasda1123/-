<view class="container">
  <scroll-view class="status-tabs" scroll-x>
    <view class="tab-list">
      <view
        wx:for="{{statusList}}"
        wx:key="*this"
        class="tab {{activeStatus===item?'on':''}}"
        data-status="{{item}}"
        bindtap="switchStatus"
      >{{item}}</view>
    </view>
  </scroll-view>

  <view class="order-list">
    <block wx:for="{{orders}}" wx:key="id">
      <view wx:if="{{activeStatus==='全部' || activeStatus===item.status}}" class="card order-item">
        <view class="row between">
          <text>{{item.lineTitle}}</text>
          <text class="status">{{item.status}}</text>
        </view>
        <view class="meta">出发：{{item.date}} · 金额：¥{{item.amount}}</view>
        <view class="meta">电子凭证：{{item.voucher}}</view>

        <view wx:if="{{item.status==='待付款'}}" class="actions">
          <button size="mini" type="warn">继续支付</button>
          <button size="mini" bindtap="completeOrder" data-id="{{item.id}}">模拟出行完成</button>
        </view>

        <view wx:if="{{item.status==='已完成'}}" class="actions">
          <button size="mini" bindtap="addComment" data-id="{{item.id}}">发布图文评价</button>
        </view>

        <view wx:if="{{item.comment}}" class="comment">评价：{{item.comment}}</view>
      </view>
    </block>
  </view>
</view>
