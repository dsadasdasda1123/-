.hero-cover {
  width: 100%;
  height: 340rpx;
}

.hero-content {
  padding: 24rpx;
}

.hero-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.hero-meta {
  color: #6b7280;
  margin-bottom: 16rpx;
}

.hero-price {
  color: #ef4444;
  font-size: 36rpx;
  font-weight: 700;
}

.block {
  padding: 24rpx;
}

.block-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #e8f0ff;
  color: #1d4ed8;
}

.intro {
  line-height: 1.8;
  color: #374151;
}

.seat-info {
  margin-top: 14rpx;
  color: #2563eb;
}

.booking-btn {
  margin-top: 40rpx;
}
