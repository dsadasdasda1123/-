page {
  background: #f4f7fb;
  color: #1f2937;
  font-size: 28rpx;
}

.container {
  padding: 30rpx;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.08);
  margin-bottom: 24rpx;
  overflow: hidden;
}

.btn-primary {
  border: none;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #2f6fed, #5189ff);
  color: #ffffff;
  font-weight: 600;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}
